# 서버: sudo install -m 640 -o root -g docker deploy/app.env.example /etc/workout/app.env 후 값 입력
# (docker 그룹 읽기 권한: 자동 배포가 sudo 없이 docker compose 를 실행할 때 이 파일을 읽는다)
# 가입 코드가 비어 있으면 가입할 수 없다. 공개 저장소에 적힌 값은 쓰지 않는다.
WORKOUT_DB_URL=jdbc:postgresql://127.0.0.1:5432/workout
WORKOUT_DB_USER=workout_app
WORKOUT_DB_PASSWORD=
WORKOUT_SIGNUP_CODE=
WORKOUT_KAKAO_JS_KEY=
