<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="workout.auth.dao.AuthDAO">

    <select id="selectUserByUsername" parameterType="string" resultType="java.util.HashMap">
        SELECT id, username, password_hash
        FROM app_user
        WHERE username = #{username}
    </select>

    <select id="selectPasswordHash" parameterType="long" resultType="string">
        SELECT password_hash FROM app_user WHERE id = #{userId}
    </select>

    <update id="updatePassword" parameterType="map">
        UPDATE app_user SET password_hash = #{passwordHash} WHERE id = #{userId}
    </update>

    <insert id="insertUser" parameterType="map" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO app_user (username, password_hash)
        VALUES (#{username}, #{passwordHash})
    </insert>

</mapper>
